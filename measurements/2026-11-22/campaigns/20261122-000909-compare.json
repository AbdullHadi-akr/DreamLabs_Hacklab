    },
    {
      "id": "ensemble-16",
      "label": "Temporal ensemble (16)",
      "description": "Asks every 16 steps (0.8 s) and averages the arm joints of all plans that cover a step (fresh predictions weigh more; the gripper follows the newest plan). Averages out plan noise, follows new plans with lag and can slow the arm down. ~3\u00d7 the requests.",
      "execute": 16,
      "blend": "ensemble",
      "requests_factor": 3.0,
      "gripper": "newest plan"
    },
    {
      "id": "crossfade-16",
      "label": "Crossfade (16)",
      "description": "Asks every 16 steps (0.8 s) and fades the arm joints from the previous plan to the new one over those steps (the gripper follows the new plan). No seam jumps, fully on the new plan after 0.8 s. ~3\u00d7 the requests.",
      "execute": 16,
      "blend": "crossfade",
      "requests_factor": 3.0,
      "gripper": "newest plan"
    }
